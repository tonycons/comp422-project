// AI-GENERATED (Claude, 2026-10-29) - see AI_CONTRIBUTIONS.md
{
    // Use the project's own Python environment (.venv) once it exists.
    // Create it with:  Terminal > Run Task... > "Setup: create .venv + install requirements"
    "python.terminal.activateEnvironment": true,

    // Testing panel (beaker icon) runs tests/ with Python's built-in unittest.
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py", "-t", "."],

    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/__pycache__": true
    },
    "[python]": {
        "editor.tabSize": 4
    }
}
